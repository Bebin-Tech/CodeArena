# Copy to .env; setup-dev.ps1 generates a random local password automatically.
POSTGRES_USER=codearena
POSTGRES_PASSWORD=
POSTGRES_DB=codearena
POSTGRES_PORT=5432
REDIS_PORT=6379
SECRET_KEY=
FRONTEND_URL=http://127.0.0.1:3000
API_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0
ENVIRONMENT=development
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Gmail alternative: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_STARTTLS=true, SMTP_USERNAME=your Gmail, MAIL_FROM=CodeArena <your Gmail>.
# Store the Google App Password privately as SMTP_PASSWORD.
MAIL_FROM=CodeArena <accounts@codearena.local>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
